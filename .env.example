# Environment Variables Template
# Copy this to .env and fill in values

# App
APP_ENV=development
APP_PORT=8085

# Database
DATABASE_URL=postgres://noidk:changeme@localhost:5439/noidk?sslmode=disable
DB_PASSWORD=changeme

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15
REFRESH_EXPIRY=7

# CORS
CORS_ORIGIN=http://localhost:3005

# Uploads
UPLOAD_DIR=./uploads

# Providers
MAPS_PROVIDER=osm
STORAGE_PROVIDER=local
SEARCH_PROVIDER=postgres
